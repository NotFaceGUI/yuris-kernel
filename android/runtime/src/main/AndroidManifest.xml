<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!-- 内核按真实文件路径读写游戏目录(Tyn 传的是绝对路径),因此仍需要
         「所有文件访问」;Android 10 及以下走旧存储模型。 -->
    <uses-permission
        android:name="android.permission.MANAGE_EXTERNAL_STORAGE"
        tools:ignore="ScopedStorage" />
    <uses-permission
        android:name="android.permission.READ_EXTERNAL_STORAGE"
        android:maxSdkVersion="29" />
    <uses-permission
        android:name="android.permission.WRITE_EXTERNAL_STORAGE"
        android:maxSdkVersion="29" />

    <application
        android:label="Yu-ris Runtime"
        android:icon="@mipmap/ic_launcher"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:hardwareAccelerated="true"
        android:largeHeap="true"
        android:allowBackup="false"
        android:requestLegacyExternalStorage="true">

        <!-- Tyranor-Next 唯一入口:只解析协议、过存储权限闸,然后把文件夹
             直接交给游戏页;没有内容视图,也不提供任何配置界面。 -->
        <activity
            android:name="org.yuris.kernel.TyranorRuntimeActivity"
            android:exported="true"
            android:label="Yu-ris Runtime"
            android:launchMode="singleTask"
            android:theme="@android:style/Theme.Translucent.NoTitleBar"
            android:configChanges="orientation|screenSize|keyboardHidden">

            <intent-filter>
                <action android:name="com.tyranor.runtime.action.LAUNCH" />
                <category android:name="android.intent.category.DEFAULT" />
            </intent-filter>

            <!-- 扫描 / 单游戏设置 / 存档目录 / 字体导入的静态声明。
                 1.73 主 App 只读这份 JSON,不执行模块代码做扫描。 -->
            <meta-data
                android:name="com.tyranor.runtime.MANIFEST"
                android:resource="@raw/tyranor_runtime" />
        </activity>

        <!-- 复用 :app 的游戏页(TextureView + JNI),不重复实现渲染壳。
             任务/最近任务标签由这里的 label 决定。 -->
        <activity
            android:name="org.yuris.kernel.MainActivity"
            android:exported="false"
            android:label="Yu-ris Runtime"
            android:theme="@android:style/Theme.Black.NoTitleBar.Fullscreen"
            android:screenOrientation="landscape"
            android:configChanges="orientation|screenSize|keyboardHidden"
            android:launchMode="singleTask" />
    </application>
</manifest>
