{
  "protocol": 1,
  "label": "Yu-ris Runtime",
  "scan": {
    "match": "any",
    "extensions": [".ypf", ".ymv"],
    "markers": ["yscfg.dat", "ys*.dll", "data.ypf", "data/*.ypf", "data/ysbin", "ysbin"]
  },
  "settings": {
    "version": 1,
    "items": [
      {
        "key": "fps",
        "type": "enum",
        "title": "帧率上限",
        "default": "60",
        "options": [
          { "value": "30", "title": "30 fps" },
          { "value": "60", "title": "60 fps" },
          { "value": "120", "title": "120 fps" }
        ]
      },
      {
        "key": "mouse_mode",
        "type": "boolean",
        "title": "虚拟光标",
        "default": false,
        "description": "关 = 直接触摸；开 = 虚拟光标"
      },
      {
        "key": "gpu_backend",
        "type": "enum",
        "title": "GPU 接口",
        "default": "auto",
        "options": [
          { "value": "auto", "title": "自动" },
          { "value": "gles", "title": "GLES" },
          { "value": "vulkan", "title": "Vulkan" }
        ]
      },
      {
        "key": "movie_backend",
        "type": "enum",
        "title": "视频解码",
        "default": "auto",
        "options": [
          { "value": "auto", "title": "自动（推荐）" },
          { "value": "builtin", "title": "内置（MPEG-1）" },
          { "value": "external", "title": "外置（设备 MediaCodec）" }
        ]
      },
      {
        "key": "patch",
        "type": "enum",
        "title": "文本编码",
        "default": "auto",
        "options": [
          { "value": "auto", "title": "自动（推荐）" },
          { "value": "original", "title": "原版（CP932）" },
          { "value": "gbk", "title": "简体（GBK）" },
          { "value": "big5", "title": "繁体（Big5）" },
          { "value": "tunnel", "title": "隧道（sjis_ext）" }
        ],
        "description": "汉化包整包换过编码时才需要显式选择"
      },
      {
        "key": "save_codec",
        "type": "enum",
        "title": "存档压缩",
        "default": "auto",
        "options": [
          { "value": "auto", "title": "自动判定" },
          { "value": "zlib", "title": "zlib" },
          { "value": "snappy", "title": "snappy" }
        ]
      },
      {
        "key": "font",
        "type": "text",
        "title": "字体",
        "default": "",
        "maxLength": 1024,
        "description": "留空 = 自动（优先使用本游戏 fonts/ 下导入的字体）；可填字体族名或 .ttf/.otf/.ttc 绝对路径"
      },
      {
        "key": "translate",
        "type": "boolean",
        "title": "运行时翻译",
        "default": true,
        "description": "游戏目录存在 translate.json 时自动加载；推荐用下方「导入翻译文件」把自己的文本放进去"
      },
      {
        "key": "bilinear_scale",
        "type": "boolean",
        "title": "SIZE 双线性",
        "default": true,
        "description": "手机画质更平滑；关闭时按官方最近邻采样"
      },
      {
        "key": "font_fallback",
        "type": "boolean",
        "title": "缺字补全",
        "default": false,
        "description": "主字体缺字时用宿主字体补字形"
      },
      {
        "key": "prefetch",
        "type": "boolean",
        "title": "资产预取",
        "default": false,
        "description": "后台解码，减少切场景卡顿"
      },
      {
        "key": "snapshot_defer",
        "type": "boolean",
        "title": "快照延迟",
        "default": false,
        "description": "菜单打开时少拷贝一份画面"
      },
      {
        "key": "debug_log",
        "type": "boolean",
        "title": "调试日志",
        "default": false,
        "description": "写游戏目录 debug/yu-kernel.jsonl"
      },
      {
        "key": "show_hud",
        "type": "boolean",
        "title": "状态浮层",
        "default": false
      },
      {
        "key": "version_badge",
        "type": "boolean",
        "title": "版本名角标",
        "default": false,
        "description": "左下角显示引擎版本"
      },
      {
        "key": "vm_profile",
        "type": "boolean",
        "title": "VM 归因",
        "default": false
      },
      {
        "key": "asset_timing",
        "type": "boolean",
        "title": "资产计时",
        "default": false
      },
      {
        "key": "tick_split",
        "type": "boolean",
        "title": "tick 分段",
        "default": false
      },
      {
        "key": "cg_timing",
        "type": "boolean",
        "title": "CG 计时",
        "default": false
      }
    ]
  },
  "saves": {
    "version": 1,
    "directory": "save"
  },
  "fileImports": {
    "version": 1,
    "items": [
      {
        "key": "fonts",
        "title": "导入字体",
        "directory": "fonts",
        "multiple": true
      },
      {
        "key": "translate",
        "title": "导入翻译文件 translate.json",
        "directory": ".",
        "fileName": "translate.json"
      }
    ]
  }
}
