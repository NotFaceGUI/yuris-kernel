# 工作须知含真名对照表,永不入库
AGENTS.md

/target

# 从 crates/ 工作目录运行探针/用例时的产物目录(截图、报告等)
crates/target/

# 本地预演 Release 更新日志的产物
/.release

# 机器相关配置(含本机路径)
.cargo/

# 游戏数据、封包与产物不入库
*.ypf
*.ymv
save/
shots_*/
dump_tex/
docs/reverse/

# Python 采集器缓存
__pycache__/
*.pyc

# K2 产物:wasm-bindgen 输出与前端依赖(不入库)
www/pkg/
www/node_modules/

.VsCodeCounter/

# Android 构建产物:K2 的 so 与 Gradle 输出不入库(so 由 cargo 现场构建)
android/app/src/main/jniLibs/
android/.gradle/
android/build/
android/app/build/
android/local.properties

# iOS 构建产物:Xcode 工程由 xcodegen 生成,静态库由 tools/ios/build.sh 产出
/dist/
ios/*.xcodeproj/
ios/DerivedData/
ios/build/
ios/xcuserdata/
ios/**/xcuserdata/

# ZCode 会话本地状态(不属仓库)
/.zcode/
